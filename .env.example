# ===== 腾讯云凭证（图片/视频/文本 AI 识别 + 人脸防护盾共用）=====
# 从 https://console.cloud.tencent.com/cam/capi 获取
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key
# 临时密钥（可选，STS Token）
# TENCENTCLOUD_TOKEN=

# ===== 各内容识别服务的审核策略号 BizType（在内容安全控制台各配一个）=====
# 图片 AI 生成识别：https://console.cloud.tencent.com/cms/clouds/manage
TENCENTCLOUD_AIGC_RECOG_IMAGE_BIZ_TYPE=
# 视频 AI 生成识别
TENCENTCLOUD_AIGC_RECOG_VIDEO_BIZ_TYPE=
# 文本 AI 生成识别
TENCENTCLOUD_AIGC_RECOG_TEXT_BIZ_TYPE=

# ===== VITA 多模态交叉验证（可选，独立 API Key）=====
# 在图像分析与处理控制台 → VITA 图像理解 → 服务管理创建
TENCENTCLOUD_VITA_API_KEY=
